# =============================================================================
# .dockerignore — Backend (Acervo.API)
# Must live next to the compose build context (backend/Acervo/), not only
# next to the Dockerfile. Docker only reads .dockerignore from the context root.
# =============================================================================

# Host SDK pin — image SDK comes from mcr.microsoft.com/dotnet/sdk:10.0
global.json

# Local build output
**/bin/
**/obj/

# Tests (not part of the production image)
**/*.Tests/

# Local secrets / machine config
**/appsettings.Development.json
**/.env

# IDE
**/.vs/
**/.vscode/
**/.idea/
**/*.user

# Git
**/.git/
**/.gitignore
