# Dependencies (installed inside the build stage)
node_modules/

# Local build artifacts
dist/
.angular/

# Local environment overrides
src/environments/environment.development.ts

# IDEs / tooling
.vscode/
.idea/
*.log

# Git
.git/
.gitignore
